font-family = Fira Code
font-family = Symbols Nerd Font Mono
font-family = Noto Color Emoji
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium
font-style-bold-italic = Bold

window-padding-x = 2
window-padding-y = 2

confirm-close-surface = false
adjust-cursor-thickness = 1
shell-integration = zsh

keybind = alt+n=new_window
keybind = alt+p=new_tab
keybind = alt+]=next_tab
keybind = alt+[=previous_tab
keybind = alt+w=close_surface

keybind = alt+u=scroll_page_up
keybind = alt+d=scroll_page_down

keybind = alt+v=new_split:right
keybind = alt+s=new_split:down
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

